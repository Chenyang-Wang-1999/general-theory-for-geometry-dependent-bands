  author = {Wu, Maopeng and Zhao, Qian and Kang, Lei and Weng, Mingze and Chi, Zhonghai and Peng, Ruiguang and Liu, Jingquan and Werner, Douglas H. and Meng, Yonggang and Zhou, Ji},
  year = {2023},
