@article{gaoTwoDimensionalReconfigurableNonHermitian2023,
  title = {Two-{{Dimensional Reconfigurable Non-Hermitian Gauged Laser Array}}},
  author = {Gao, Zihe and Qiao, Xingdu and Pan, Mingsen and Wu, Shuang and Yim, Jieun and Chen, Kaiyuan and Midya, Bikashkali and Ge, Li and Feng, Liang},
