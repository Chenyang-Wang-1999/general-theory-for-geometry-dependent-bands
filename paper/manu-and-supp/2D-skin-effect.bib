@article{chengTruncationdependent$mathcalPT$Phase2022,
  title = {Truncation-Dependent \${\textbackslash}mathcal\{\vphantom\}{{PT}}\vphantom\{\}\$ Phase Transition for the Edge States of a Two-Dimensional Non-{{Hermitian}} System},
  author = {Cheng, Dali and Peng, Bo and Xiao, Meng and Chen, Xianfeng and Yuan, Luqi and Fan, Shanhui},
