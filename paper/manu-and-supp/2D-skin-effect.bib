  journal = {Phys. Rev. Lett.},
  volume = {126},
  number = {17},
  pages = {176601},
  publisher = {American Physical Society},
  urldate = {2021-12-14},
  abstract = {There is a common belief in the condensed matter community that bulk quantities become insensitive to the boundary condition in the infinite-volume limit. Here we reconsider this statement in terms of recent arguments of non-Hermitian skin effects---strong dependence of spectra on boundary conditions for the non-Hermitian Hamiltonians---in the traditional Green's function formalism. We find the criterion for quantities to be sensitive or insensitive against the boundary condition in Hermitian correlated or disordered systems, which is characterized by the residue theorem. We also discuss the uncertainty of the quasiparticle energy under the skin effects in terms of non-normal pseudospectra, which can be tested via the sharp optical absorption from the bulk-surface coupling. Our result indicates that pseudo quantum number emerges as a consequence of large nonnormality.},
  keywords = {correlated,Green's function,non-Hermitian,non-Hermitian/non-Hermitian skin effect,non-Hermitian/non-Hermitian skin effect/non-Bloch},
  file = {D\:\\information-base\\library\\非厄米与量子开放\\2021_Physical Review Letters_Okuma_Sato_Non-Hermitian Skin Effects in Hermitian Correlated or Disordered Systems.pdf;D\:\\information-base\\zotero-data\\storage\\RHUXPFB3\\PhysRevLett.126.html}
}

@article{okumaTopologicalPhaseTransition2019,
  title = {Topological {{Phase Transition Driven}} by {{Infinitesimal Instability}}: {{Majorana Fermions}} in {{Non-Hermitian Spintronics}}},
  author = {Okuma, Nobuyuki and Sato, Masatoshi},
  year = {2019},
